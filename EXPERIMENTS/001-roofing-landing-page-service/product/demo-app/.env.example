# Copy to .env.local for local development.
# Use scripts/Manage-DashboardUsers.ps1 to generate/update DASHBOARD_USERS_JSON.
DASHBOARD_AUTH_SECRET=replace-with-random-32-byte-secret
DASHBOARD_USERS_JSON='[{"username":"digidap","role":"admin","passwordHash":"sha256:replace-with-script-generated-hash"}]'

# Optional: enables the dashboard email draft drawer to read public.prospects server-side.
# Keep the service role key server-only. Do not expose it as NEXT_PUBLIC_*.
SUPABASE_URL=https://uwukaydnmwiwggqoemtc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
