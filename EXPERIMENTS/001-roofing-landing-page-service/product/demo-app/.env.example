# Copy only when .env.local does not exist. Preserve existing environment values.
# Follow docs/dashboard-access.md for the migration and sole-operator setup.
# These are all server-only. Missing values deliberately deny private access.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DASHBOARD_OPERATOR_ID=
DASHBOARD_APP_ORIGIN=http://localhost:3000

# Production/Preview require HTTPS and their actual application origin.
# DASHBOARD_AUTH_SECRET and DASHBOARD_USERS_JSON are retired and ignored.
